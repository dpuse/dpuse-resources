{
    "name": "dpuse-resources",
    "version": "1.0.102",
    "private": true,
    "description": "Sample data files.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-resources/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-resources.git"
    },
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "workerd@1.20261001.1": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "build": "node scripts/buildIndexes.ts",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject())\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "generate:globalWorkforce": "node scripts/generateGlobalWorkforce.ts",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run sync && npm run _upload:applicationDirectoryToR2 && npm run _upload:fileStoreDirectoryToR2",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\"",
        "_upload:applicationDirectoryToR2": "node -e \"import('@dpuse/dpuse-development').then(m => m.uploadDirectoryToR2('public', 'application'))\"",
        "_upload:fileStoreDirectoryToR2": "node -e \"import('@dpuse/dpuse-development').then(m => m.uploadDirectoryToR2('public', 'fileStore'))\""
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^1.0.110",
        "@faker-js/faker": "^10.6.0",
        "@snaplet/copycat": "^6.0.0",
        "@types/node": "^26.6.4",
        "jiti": "^2.7.0",
        "license-checker-rseidelsohn": "^5.0.1",
        "nanoid": "^6.0.1",
        "npm-check-updates": "^23.1.0",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "wrangler": "^4.147.0"
    }
}
