{
    "$schema": "https://datapackage.org/profiles/2.0/dataresource.json",
    "name": "people",
    "path": "people.csv",
    "format": "csv",
    "mediatype": "text/csv",
    "encoding": "utf-8",
    "dialect": {
        "header": true,
        "delimiter": ","
    },
    "schema": {
        "fields": [
            {
                "name": "personId",
                "title": "Person ID",
                "type": "string"
            },
            {
                "name": "firstName",
                "title": "First name",
                "type": "string"
            },
            {
                "name": "lastName",
                "title": "Last name",
                "type": "string"
            },
            {
                "name": "birthDate",
                "title": "Birth date",
                "type": "date"
            },
            {
                "name": "genderId",
                "title": "Gender",
                "type": "string"
            },
            {
                "name": "ethnicBackgroundId",
                "title": "Ethnic background",
                "type": "string"
            },
            {
                "name": "locationId",
                "title": "Location ID",
                "type": "string"
            }
        ]
    }
}
