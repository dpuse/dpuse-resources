    "mediatype": "text/csv",
    "encoding": "utf-8",
    "dialect": {
        "header": true,
        "delimiter": ","
    },
    "schema": {
        "fields": [
            {
                "name": "employmentId",
                "title": "Employment ID",
                "type": "string"
            },
            {
                "name": "personId",
                "title": "Person ID",
                "type": "string"
            },
            {
                "name": "employerId",
                "title": "Employer ID",
                "type": "string"
            },
            {
                "name": "hireDate",
                "title": "Hire date",
                "type": "date"
            },
            {
                "name": "terminationDate",
                "title": "Termination date",
                "type": "date"
            }
        ]
    }
}
